[
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read the CURRENT forward slot map of a site: the assignments (sku, slot, abc_class) of its Approved plan, with that plan_id and approved_at. A site without an Approved plan yields an empty assignment list and no plan_id, not an error. site_id defaults to the service's default site. Read-only; fails with invalid-site-id for a malformed site or when no site is given and no default is configured.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "description": "the site to read the forward slot map of; omitted means the service's default site",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "get_forward_slots",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "type": "string"
        },
        "assignments": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "abc_class": {
                "type": "string"
              },
              "sku": {
                "type": "string"
              },
              "slot": {
                "type": "string"
              }
            },
            "required": [
              "sku",
              "slot",
              "abc_class"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "plan_id": {
          "type": "string"
        },
        "site_id": {
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "assignments"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read the demand the planner works from: per SKU the ACTIVE order lines (picks) and units over the last window_days days (default 28, max 365) of a site, fastest first, cut to limit SKUs (default 100, max 500). site_id defaults to the service's default site. Returns window_from and window_to (UTC). Read-only; a bad limit or window fails with invalid-limit and a malformed or missing site with invalid-site-id.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "keep only the N fastest SKUs, 1..500; omitted or 0 means 100",
          "type": "integer"
        },
        "site_id": {
          "description": "the site to read demand of; omitted means the service's default site",
          "type": "string"
        },
        "window_days": {
          "description": "demand window in days ending now, 1..365; omitted or 0 means 28",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "get_sku_velocity",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "picks": {
                "type": "integer"
              },
              "sku": {
                "type": "string"
              },
              "units": {
                "type": "integer"
              }
            },
            "required": [
              "sku",
              "picks",
              "units"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "site_id": {
          "type": "string"
        },
        "window_from": {
          "type": "string"
        },
        "window_to": {
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "window_from",
        "window_to",
        "items"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read one forward pick slot plan by id: site_id, state (Draft, Approved, Rejected or Superseded), policy, the demand window (window_from, window_to), generated_at and the decision instants (approved_at, rejected_at, superseded_at, each omitted until it happens), reject_reason and supersedes_plan_id (omitted when none), the assignments (sku, slot, abc_class, picks, units), the moves against the previous plan (sku, from_slot, to_slot, kind) and the unassigned SKUs with their reason, plus version. Read-only; fails with plan-not-found for an unknown id and invalid-plan-id for a malformed one.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "description": "the slot plan id returned when it was generated, e.g. plan-1b4e28ba-2fa1-4d3c-8f6e-0a1b2c3d4e5f",
          "type": "string"
        }
      },
      "required": [
        "plan_id"
      ],
      "type": "object"
    },
    "name": "get_slot_plan",
    "outputSchema": {
