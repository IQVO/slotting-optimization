                "type": "string"
              }
            },
            "required": [
              "sku",
              "kind"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "plan_id": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "reject_reason": {
          "type": "string"
        },
        "rejected_at": {
          "type": "string"
