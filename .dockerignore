# Version control / CI
.git
.github
.gitignore

# Docker itself (no need to ship these into the build context)
Dockerfile
.dockerignore
docker-compose.yml

# Docs, task notes, and other non-runtime artifacts that shouldn't
# invalidate the Docker build cache when edited
*.md
docs/
executive/
charts/

# Agent harness and tooling that is never part of `go build`
.agents/
.claude/
.codex/
.opencode/
scripts/
tools/
templates/

# Tool configs irrelevant to `go build`
.golangci.yml
.gremlins.yaml
.spectral.yaml
.spectral.asyncapi.yaml
lefthook.yml

# Local dev / test output
bin/
coverage.out
coverage.html
*.test
*.out
.env
.env.*

# Editors / OS cruft
.vscode/
.idea/
.DS_Store
